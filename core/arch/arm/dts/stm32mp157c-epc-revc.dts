/dts-v1/;

#include "stm32mp157c-ed1.dts"
//#include <dt-bindings/input/input.h>
//#include <dt-bindings/soc/stm32-hdp.h>
#include "stm32mp157c-epc-common-pinctrl.dtsi"
#include "stm32mp157c-epc-revc-pinctrl.dtsi"
#include "stm32mp157c-epc-common-gpio-defaults.dtsi"
#include "stm32mp157c-epc-common-platform.dtsi"

/ {
    model = "FORT Robotics EPC 1.0";
    compatible = "stm32mp157c-epc-revc", "st,stm32mp157c-ed1", "st,stm32mp157";

    chosen {
        stdout-path = "serial0:115200n8";
    };

    memory@c0000000 {
        reg = <0xc0000000 0x20000000>;
    };

    aliases {
        serial1 = &usart3;
        ethernet0 = &ethernet0;
        i2c6 = &i2c6;
    };

    led {
        compatible = "gpio-leds";
        /delete-node/ blue;
        green {
            label = "heartbeat";
            gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
            linux,default-trigger = "heartbeat";
            default-state = "off";
            drive-open-drain;
        };
    };

    /delete-node/ sd_switch;
};

&adc {
    status = "disabled";
};

&cec {
    status = "disabled";
};

&dac {
    status = "disabled";
};

&dcmi {
    status = "disabled";
};

&dfsdm {
    status = "disabled";
};

&dsi {
    status = "disabled";
};

&ethernet0 {
    status = "okay";
    pinctrl-0 = <&ethernet0_rmii_pins_a>;
    pinctrl-1 = <&ethernet0_rmii_pins_sleep_a>;
    pinctrl-names = "default", "sleep";
    phy-mode = "rmii";
    max-speed = <1000>;
    phy-handle = <&phy0>;

    mdio0 {
        #address-cells = <1>;
        #size-cells = <0>;
        compatible = "snps,dwmac-mdio";
        phy0: ethernet-phy@0 {
            reg = <0>;
        };
    };
};

&fmc {
    status = "disabled";
};

#if 0
&hdp {
    status = "disabled";
};
#endif

&i2c2 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&i2c2_pins_a>;
    pinctrl-1 = <&i2c2_pins_sleep_a>;
    status = "okay";
    /delete-property/dmas;
    /delete-property/dma-names;
};

&i2c4 {
    pinctrl-0 = <&i2c4_pins_b &i2c4_pins_b_z>;
    pinctrl-1 = <&i2c4_pins_sleep_b &i2c4_pins_sleep_b_z>;

    pmic: stpmic@33 {
        regulators {
            vdd_sd: ldo5 {
                regulator-min-microvolt = <3300000>;
                regulator-max-microvolt = <3300000>;
            };

            v1v8: ldo6 {
                regulator-enable-ramp-delay = <300000>;
            };
        };

        onkey {
            status = "disabled";
        };
    };
};

&i2c5 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&i2c5_pins_a>;
    pinctrl-1 = <&i2c5_pins_sleep_a>;
    i2c-scl-rising-time-ns = <185>;
    i2c-scl-falling-time-ns = <20>;
    /delete-property/dmas;
    /delete-property/dma-names;
};

&i2c6 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&i2c6_pins_a>;
    pinctrl-1 = <&i2c6_pins_sleep_a>;
    i2c-scl-rising-time-ns = <185>;
    i2c-scl-falling-time-ns = <20>;
    /delete-property/dmas;
    /delete-property/dma-names;
    status = "okay";
    clock-frequency=<400000>;

};

&ipcc {
    status = "disabled";
};

&iwdg2 {
    status = "disabled";
};

&ltdc {
    status = "disabled";
};

&m4_rproc {
    status = "disabled";
};

&m_can1 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&m_can1_pins_a>;
    pinctrl-1 = <&m_can1_sleep_pins_a>;
    status = "okay";
};

&pwr_regulators {
    /delete-property/ vdd_3v3_usbfs-supply;
};

&qspi {
    status = "disabled";
};

&sai2 {
    status = "disabled";

    sai2a: audio-controller@4400b004 {
        status = "disabled";
    };

    sai2b: audio-controller@4400b024 {
        status = "disabled";
    };
};

&sai4 {
    status = "disabled";

    sai4a: audio-controller@50027004 {
        status = "disabled";
    };
};

&sdmmc1 {
    pinctrl-0 = <&sdmmc1_b4_pins_a>;
    pinctrl-1 = <&sdmmc1_b4_od_pins_a>;
    pinctrl-2 = <&sdmmc1_b4_sleep_pins_a>;
    vmmc-supply = <&vdd_sd>;
    vqmmc-supply = <&vdd_sd>;
    /delete-property/ st,sig-dir;
    /delete-property/ st,use-ckin;
    /delete-property/ sd-uhs-sdr12;
    /delete-property/ sd-uhs-sdr25;
    /delete-property/ sd-uhs-sdr50;
    /delete-property/ sd-uhs-ddr50;
    /delete-property/ sd-uhs-sdr104;
    /*no-1-8-v;*/
    broken-cd;
    /*cd-gpios = <&gpiof 3 0>;*/
};

&sdmmc3 {
    status = "disabled";
};

&spdifrx {
    status = "disabled";
};

&spi1 {
    status = "disabled";
};

&timers2 {
    status = "disabled";
    /* spare dmas for other usage (un-delete to enable pwm capture) */
    /delete-property/dmas;
    /delete-property/dma-names;
    pwm {
        status = "disabled";
    };
    timer@1 {
        status = "disabled";
    };
};

&timers6 {
    status = "disabled";
    /delete-property/dmas;
    /delete-property/dma-names;
};

&timers8 {
    status = "disabled";
    /delete-property/dmas;
    /delete-property/dma-names;
    pwm {
        status = "disabled";
    };
    timer@7 {
        status = "disabled";
    };
};

&timers12 {
    status = "disabled";
    /delete-property/dmas;
    /delete-property/dma-names;
    pwm {
        status = "disabled";
    };
    timer@11 {
        status = "disabled";
    };
};

&usart3 {
    pinctrl-names = "default", "sleep", "idle";
    pinctrl-0 = <&usart3_pins_revc>;
    pinctrl-1 = <&usart3_sleep_pins_revc>;
    pinctrl-2 = <&usart3_idle_pins_revc>;
    status = "okay";
};

&usbh_ohci {
    phys = <&usbphyc_port0>;
    phy-names = "usb";
    vbus-supply = <&vdd_usb>;
    status = "okay";
};

&usbotg_hs {
    pinctrl-names = "default";
    pinctrl-0 = <&usbotg_hs_pins_a>;
    phys = <&usbphyc_port1 0>;
    phy-names = "usb2-phy";
    status = "okay";
};

&usbphyc {
    vdd3v3-supply = <&vdd_usb>;
    status = "okay";
};

&usbphyc_port0 {
    /delete-property/ st,phy-tuning;
};

&usbphyc_port1 {
    /delete-property/ st,phy-tuning;
};

